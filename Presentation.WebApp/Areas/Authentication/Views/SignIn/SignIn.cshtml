@model SignInForm
@{
    ViewData["Title"] = "Sign In";
}

<section class="section__auth">
    <div class="title">
        <h1>Welcome Back!</h1>
    </div>
    <hr />

    <div class="external-providers">
        <form method="post" asp-area="Authentication" asp-controller="SignIn" asp-action="ExternalLogin">
            @Html.AntiForgeryToken()

            <input type="hidden" name="provider" value="GitHub" />
            <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />

            <button type="submit" class="gsi-material-button">
                <div class="gsi-material-button-state"></div>

                <div class="gsi-material-button-content-wrapper">
                    <div class="gsi-material-button-icon">
                        <img class="github-icon" src="~/images/GitHub_Invertocat_Black.svg" />
                    </div>

                    <span style="display: none;">Sign in with GitHub</span>
                </div>
            </button>
        </form>
    </div>

    <div class="divider">
        <span>OR CONTINUE WITH</span>
    </div>

    <form id="signInForm" method="post" asp-area="Authentication" asp-controller="SignIn" asp-action="Index" novalidate>
        @Html.AntiForgeryToken()

        <div class="form-group">
            <label class="form-label" asp-for="Email"></label>
            <input class="form-input" asp-for="Email" autocomplete="off" />
        </div>

        <div class="form-group">
            <label class="form-label" asp-for="Password"></label>
            <input class="form-input" asp-for="Password" autocomplete="off" />
        </div>

        <div class="form-group form-checkbox-group">
            <input class="form-checkbox" asp-for="RememberMe" />
            <label class="form-label" asp-for="RememberMe"></label>
        </div>

        <button class="btn submit-button" type="submit">Continue</button>
        
        <div class="form-errormessage">
            <span class="field-validation-error">@TempData["ErrorMessage"]?.ToString()</span>
        </div>

        <div asp-validation-summary="ModelOnly"></div>
        <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
    </form>

</section>
