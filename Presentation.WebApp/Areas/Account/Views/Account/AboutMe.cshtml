@using Presentation.WebApp.Areas.Account.Models
@model AboutMeViewModel
@{
    ViewData["Title"] = "My Account";
}

<aside>
    <div class="profile-image">
        @if (!string.IsNullOrWhiteSpace(Model.ProfileImageUrl))
        {
            <img src="@Url.Content(Model.ProfileImageUrl)" alt="user profile image" />
        }
        else
        {
            <img src="~/images/profile-image-avatar.png" alt="user profile image" />
        }

    </div>

    <nav class="account-options options">
        <div class="options-menu-title">
            <h3>Options</h3>
        </div>
        <ul class="options-menu">
            <li class="option-item">
                <a class="option-item-link" asp-area="Account" asp-controller="Account" asp-action="AboutMe">About Me</a>
            </li>

            <li class="option-item">
                <a class="option-item-link" asp-area="Account" asp-controller="AccountMembership" asp-action="Index">My Membership</a>
            </li>

            <li class="option-item">
                <a class="option-item-link" asp-area="Account" asp-controller="AccountBookings" asp-action="Index">My Bookings</a>
            </li>

            <li class="option-item">
                <a class="option-item-link" asp-area="Account" asp-controller="Account" asp-action="SignOut">Sign Out</a>
            </li>
        </ul>
    </nav>

    <div class="option-input">
        <p>If you like to remove your account click below</p>
        <a class="btn remove-account" asp-area="Account" asp-controller="Account" asp-action="RemoveAccount">Remove Account</a>
    </div>

</aside>

<main>
    <section class="about-me">

        <div class="title">
            <h3>About Me</h3>
            <hr />
        </div>

        <form id="aboutMeForm" method="post" enctype="multipart/form-data" asp-area="Account" asp-controller="Account" asp-action="AboutMe" novalidate>
            <div data-type="firstname" class="form-group">
                <label class="form-label" asp-for="Form.FirstName"></label>
                <input class="form-input" asp-for="Form.FirstName" />
                <span class="form-field-validation" asp-validation-for="Form.FirstName"></span>
            </div>

            <div data-type="lastname" class="form-group">
                <label class="form-label" asp-for="Form.LastName"></label>
                <input class="form-input" asp-for="Form.LastName" />
                <span class="form-field-validation" asp-validation-for="Form.LastName"></span>
            </div>

            <div data-type="email" class="form-group">
                <label class="form-label" asp-for="Form.Email"></label>
                <input class="form-input" asp-for="Form.Email" readonly />
                <span class="form-field-validation" asp-validation-for="Form.Email"></span>
            </div>

            <div data-type="phone" class="form-group">
                <label class="form-label" asp-for="Form.PhoneNumber"></label>
                <input class="form-input" asp-for="Form.PhoneNumber" />
                <span class="form-field-validation" asp-validation-for="Form.PhoneNumber"></span>
            </div>

            <hr />

            <div data-type="file" class="form-group">
                <label class="form-label" asp-for="Form.ProfileImage"></label>
                <input class="btn form-input" asp-for="Form.ProfileImage" />
                <span class="form-field-validation" asp-validation-for="Form.ProfileImage"></span>
            </div>

            <div data-type="submit" class="form-group">
                <button class="btn" type="submit">Save</button>
            </div>


            <div asp-validation-summary="ModelOnly"></div>
            @Html.AntiForgeryToken()
        </form>
    </section>
</main>
