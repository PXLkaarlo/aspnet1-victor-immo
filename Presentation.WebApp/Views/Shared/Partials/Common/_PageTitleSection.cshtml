@if (!string.IsNullOrWhiteSpace(ViewData["Title"]?.ToString()))
{
    <section class="page-title">
        <h1>@ViewData["Title"]?.ToString()</h1>
    </section>
}
else
{
    <section class="page-title">
        <h1>There's supposed to be something here. But it's not showing up. ERROR</h1>
    </section>
}